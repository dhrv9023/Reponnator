# CodeAutopsy — Environment Variables Template
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# .env is in .gitignore — never commit secrets.

# ---------------------------------------------------------------------------
# GitHub Personal Access Token
# ---------------------------------------------------------------------------
# Without a token: limited to 60 API requests per hour (unauthenticated).
# With a token:    5,000 API requests per hour.
#
# Create one at:   https://github.com/settings/tokens
# Required scopes: public_repo (for public repos only)
#                  repo       (to also access private repos)
#
GITHUB_TOKEN=your_github_token_here

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Set to DEBUG for verbose output, INFO for normal, WARNING for quiet.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase 4: LLM Configuration for RAG Q&A
# ---------------------------------------------------------------------------
# Choose your LLM provider: "gemini" (free, cloud) or "ollama" (local)
LLM_PROVIDER=gemini

# Gemini API Key (FREE - get from https://aistudio.google.com/app/apikey)
# Free tier: 15 requests/min, 1M tokens/min
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (if using local LLM)
# Install from: https://ollama.ai
# Then run: ollama pull mistral && ollama serve
# OLLAMA_MODEL=mistral
